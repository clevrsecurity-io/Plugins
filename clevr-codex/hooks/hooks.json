{
  "hooks": {
    "SessionStart": [{ "command": "node ~/.clevr/tools/codex/clevr-codex-session.mjs", "timeout": 5 }],
    "UserPromptSubmit": [{ "command": "node ~/.clevr/tools/codex/clevr-codex-prompt.mjs", "timeout": 10 }],
    "PreToolUse": [{ "command": "node ~/.clevr/tools/codex/clevr-codex-gate.mjs", "timeout": 10 }],
    "PostToolUse": [{ "command": "node ~/.clevr/tools/codex/clevr-codex-result.mjs", "timeout": 10 }],
    "SubagentStart": [{ "command": "node ~/.clevr/tools/codex/clevr-codex-subagent.mjs", "timeout": 10 }],
    "Stop": [{ "command": "node ~/.clevr/tools/codex/clevr-codex-stop.mjs", "timeout": 10 }]
  }
}
